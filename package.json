{
  "name": "grud-structorizer",
  "version": "3.0.0",
  "description": "Core library for building schemas",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/types.d.ts",
  "files": [
    "lib/"
  ],
  "scripts": {
    "build": "mkdir -p lib && cp -r src/* lib/ && rm -rf lib/__tests__ 2>/dev/null",
    "clean": "rm -rf ./lib ./docs",
    "prepublishOnly": "npm run build -s && npm run lint -s && npm run test -s && npm run jsdoc -s && npm run jsdoc:ts -s",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ./src",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "jsdoc": "jsdoc -c ./.jdoc.json -r -R README.md -t ./node_modules/docdash/ -d ./docs ./src",
    "jsdoc:ts": "jsdoc -c ./.jdoc.json -r -t ./node_modules/tsd-jsdoc/dist -d ./lib ./src && echo 'export { grudStructorizer as default };' >> ./lib/types.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/campudus/grud-structorizer.git"
  },
  "keywords": [
    "tableaux",
    "grud",
    "schema",
    "structure"
  ],
  "author": "Campudus GmbH",
  "license": "Apache-2.0",
  "homepage": "https://github.com/campudus/grud-structorizer",
  "devDependencies": {
    "docdash": "^2.0.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-promise": "^7.1.0",
    "jsdoc": "^3.6.3",
    "prettier": "^3.6.2",
    "tsd-jsdoc": "^2.5.0",
    "vitest": "^4.0.12"
  },
  "dependencies": {
    "lodash": "4.17.21",
    "sync-request": "6.1.0"
  }
}
